// Esquema de base de datos - Gestión de Pedidos LYA
// Basado en el documento de prerrequisitos del proyecto

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// Usuarios y Perfiles
// ---------------------------------------------------------

model Perfil {
  id          String   @id @default(cuid())
  nombre      String   @unique // "Administrador", "Vendedor", (futuros perfiles)
  descripcion String?
  usuarios    Usuario[]
  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

enum EstadoUsuario {
  PENDIENTE // se logueó con Google por primera vez, esperando que un Administrador le asigne un perfil
  ACTIVO
}

model Usuario {
  id            String    @id @default(cuid())
  nombre        String
  email         String    @unique
  passwordHash  String?   // opcional: usuarios que solo entran con Google no tienen contraseña propia
  activo        Boolean   @default(true)
  estado        EstadoUsuario @default(ACTIVO)
  sessionId     String?   // identifica la sesión activa más reciente; un login nuevo invalida las anteriores
  emailVerificado Boolean @default(true) // false solo para cuentas creadas por registro manual, hasta que confirman el link
  tokenVerificacion String? @unique
  tokenVerificacionExpira DateTime?
  perfilId      String?   // opcional: nulo mientras el usuario está PENDIENTE de autorización
  perfil        Perfil?   @relation(fields: [perfilId], references: [id])
  clientes      Cliente[] // Clientes asociados a este usuario cuando su perfil es "Vendedor"
  pedidos       Pedido[]  // Pedidos cargados por este usuario cuando su perfil es "Vendedor"
  lotes         Lote[]    // Lotes armados por este usuario
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt
}

// ---------------------------------------------------------
// Marcas y Proveedores y Productos
// ---------------------------------------------------------

model Marca {
  id            String      @id @default(cuid())
  nombre        String      @unique
  activo        Boolean     @default(true)
  proveedores   Proveedor[] @relation("MarcaProveedor")
  productos     Producto[]
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt
}

model Proveedor {
  id            String    @id @default(cuid())
  nombre        String
  contacto      String?
  telefono      String?
  email         String?
  activo        Boolean   @default(true)
  marcas        Marca[]   @relation("MarcaProveedor")
  productos     Producto[]
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt
}

model Producto {
  id                  String       @id @default(cuid())
  nombre              String
  descripcion         String?
  fotoUrl             String?      // URL de la foto del producto (storage externo)
  codigoProveedor     String?      // código alfanumérico que usa el proveedor para este producto
  precioSinIva        Decimal      @db.Decimal(10, 2)
  iva                 Decimal      @db.Decimal(5, 2) @default(21) // porcentaje, ej: 21.00
  precioFinal         Decimal      @db.Decimal(10, 2) // calculado: precioSinIva * (1 + iva/100)
  precioActualizadoEn DateTime?    // se actualiza solo cuando cambia precioSinIva o iva
  stock               Int          @default(0)
  activo              Boolean      @default(true)
  proveedorId         String
  proveedor           Proveedor    @relation(fields: [proveedorId], references: [id])
  marcaId             String
  marca               Marca        @relation(fields: [marcaId], references: [id])
  itemsPedido         PedidoItem[]
  creadoEn            DateTime     @default(now())
  actualizadoEn       DateTime     @updatedAt
}

// ---------------------------------------------------------
// Provincias y Localidades
// ---------------------------------------------------------

model Provincia {
  id            String      @id @default(cuid())
  nombre        String      @unique
  localidades   Localidad[]
  clientes      Cliente[]   // solo informativo si se necesitara filtrar directo (no se persiste, ver nota abajo)
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt
}

model Localidad {
  id            String    @id @default(cuid())
  nombre        String
  provinciaId   String
  provincia     Provincia @relation(fields: [provinciaId], references: [id])
  clientes      Cliente[]
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  @@unique([provinciaId, nombre])
}

// ---------------------------------------------------------
// Clientes
// ---------------------------------------------------------

enum CategoriaCliente {
  RI
  MO
  EX
  CF
}

model Cliente {
  id            String    @id @default(cuid())
  nombre        String
  telefono      String?
  email         String?
  direccion     String?
  codigoCliente String
  cuit          String    @unique
  categoria     CategoriaCliente
  localidadId   String?
  localidad     Localidad? @relation(fields: [localidadId], references: [id])
  provinciaId   String?    // redundante a propósito: permite elegir Provincia sin depender de Localidad
  provincia     Provincia? @relation(fields: [provinciaId], references: [id])
  vendedorId    String
  vendedor      Usuario   @relation(fields: [vendedorId], references: [id])
  pedidos       Pedido[]
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt
}

// ---------------------------------------------------------
// Pedidos
// ---------------------------------------------------------

enum EstadoPedido {
  PENDIENTE
  EN_LOTE // ya pertenece a un Lote (armado por el vendedor para enviar a la distribuidora)
}

enum ModalidadPago {
  CONTADO
  CUENTA_CORRIENTE
}

enum EstadoLote {
  ABIERTO // se pueden agregar/sacar pedidos y volver a descargar el PDF
  ENVIADO // ya se marcó como enviado, queda de solo lectura
}

model Lote {
  id         String     @id @default(cuid())
  numero     Int        @default(autoincrement())
  estado     EstadoLote @default(ABIERTO)
  vendedorId String
  vendedor   Usuario    @relation(fields: [vendedorId], references: [id])
  pedidos    Pedido[]
  creadoEn   DateTime   @default(now())
  enviadoEn  DateTime?
}

model Pedido {
  id            String        @id @default(cuid())
  numero        Int           @default(autoincrement())
  estado        EstadoPedido  @default(PENDIENTE)
  clienteId     String
  cliente       Cliente       @relation(fields: [clienteId], references: [id])
  vendedorId    String
  vendedor      Usuario       @relation(fields: [vendedorId], references: [id])
  items         PedidoItem[]
  conFactura    Boolean       @default(false)
  modalidadPago ModalidadPago @default(CONTADO)
  observaciones String?       @db.Text
  loteId        String?
  lote          Lote?         @relation(fields: [loteId], references: [id])
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt
}

model PedidoItem {
  id             String   @id @default(cuid())
  pedidoId       String
  pedido         Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId     String
  producto       Producto @relation(fields: [productoId], references: [id])
  cantidad       Int
  precioSinIva   Decimal  @default(0) @db.Decimal(10, 2) // copiado del producto al momento del pedido, editable por línea
  iva            Decimal  @default(21) @db.Decimal(5, 2) // porcentaje, editable por línea
  precioUnitario Decimal  @db.Decimal(10, 2) // precio final = precioSinIva * (1 + iva/100)
  descuento      Decimal  @default(0) @db.Decimal(5, 2) // porcentaje, ej: 7.00
}
