# Base de datos (Railway te da esta URL en el servicio de PostgreSQL)
DATABASE_URL="postgresql://usuario:password@host:puerto/nombre_db"

# NextAuth (autenticación)
# Generar un valor random, por ejemplo con: openssl rand -base64 32
NEXTAUTH_SECRET="reemplazar-por-un-valor-random-y-secreto"
NEXTAUTH_URL="http://localhost:3000"

# Usuario administrador inicial (usado por el script de seed)
SEED_ADMIN_EMAIL="admin@lya.com"
SEED_ADMIN_PASSWORD="cambiar-esta-password"
