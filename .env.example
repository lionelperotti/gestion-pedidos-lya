# Base de datos (Railway te da esta URL en el servicio de PostgreSQL)
DATABASE_URL="postgresql://usuario:password@host:puerto/nombre_db"

# NextAuth (autenticación)
# Generar un valor random, por ejemplo con: openssl rand -base64 32
NEXTAUTH_SECRET="reemplazar-por-un-valor-random-y-secreto"
NEXTAUTH_URL="http://localhost:3000"

# Usuario administrador inicial (usado por el script de seed)
SEED_ADMIN_EMAIL="admin@lya.com"
SEED_ADMIN_PASSWORD="cambiar-esta-password"

# Login con Google (obtener en Google Cloud Console)
GOOGLE_CLIENT_ID="tu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-client-secret"

# Envío de emails de verificación (obtener en resend.com)
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Subida de imágenes de productos (obtener en cloudinary.com)
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"
